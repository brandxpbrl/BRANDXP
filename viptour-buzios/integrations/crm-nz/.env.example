# Server-side variables only. Configure locally in viptour-buzios/.env.local,
# or in Vercel PREVIEW scoped to feat/brand-experience-crm-nz.
# Keep disabled until access, isolated sheet and upstream security are reviewed.
CRM_NZ_ENABLED=false
CRM_NZ_ORIGIN=http://localhost:3100
CRM_NZ_AUTH_SECRET=
CRM_NZ_GOOGLE_CLIENT_ID=
CRM_NZ_GOOGLE_CLIENT_SECRET=
CRM_NZ_USERS_JSON=[]
# Example value (synthetic; do not authorize these users):
# [{"email":"admin@example.test","role":"admin","sub":"pinned-google-subject"},{"email":"ben@example.test","role":"ben","sub":"pinned-google-subject"},{"email":"cassia@example.test","role":"cassia","sub":"pinned-google-subject"}]
CRM_NZ_REFERENCE_SHEET_ID=
CRM_NZ_SHEET_ID=
CRM_NZ_APPS_SCRIPT_URL=
CRM_NZ_BRIDGE_SECRET=
CRM_NZ_PLACES_API_KEY=
CRM_NZ_GEMINI_ENABLED=false
CRM_NZ_GEMINI_API_KEY=
